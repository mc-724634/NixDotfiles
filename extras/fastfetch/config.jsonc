// Catppuccin Macchiato

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logo/catppuccin_logo.png",
    "width": 40,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2,
    },
  },
  "display": {
    "separator": " \u001b[38;2;139;213;202m\u001b[0m ",
    "constants": [
      "\u001b[38;2;139;213;202m─────────────────\u001b[0m", // {$1}, used in Custom module
    ],
    "key": {
      "type": "icon",
      "paddingLeft": 2,
    },
  },
  "modules": [
    {
      "type": "custom", // HardwareStart
      // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "\u001b[38;2;139;213;202m┌\u001b[0m{$1} \u001b[38;2;145;215;227mHardware Information\u001b[0m {$1}\u001b[38;2;139;213;202m┐\u001b[0m",
    },
    { "type": "host", "keyColor": "#7dc4e4" },
    { "type": "cpu", "keyColor": "#7dc4e4" },
    { "type": "gpu", "keyColor": "#7dc4e4" },
    { "type": "disk", "keyColor": "#7dc4e4" },
    { "type": "memory", "keyColor": "#7dc4e4" },
    { "type": "display", "keyColor": "#7dc4e4" },
    {
      "type": "custom", // InformationEnd
      "format": "\u001b[38;2;139;213;202m└\u001b[0m{$1}\u001b[38;2;139;213;202m──────────────────────\u001b[0m{$1}\u001b[38;2;139;213;202m┘\u001b[0m",
    },
    {
      "type": "custom", // Separator
      "format": "",
    },
    {
      "type": "custom", // SoftwareStart
      "format": "\u001b[38;2;139;213;202m┌\u001b[0m{$1} \u001b[38;2;145;215;227mSoftware Information\u001b[0m {$1}\u001b[38;2;139;213;202m┐\u001b[0m",
    },
    { "type": "os", "keyColor": "#7dc4e4" },
    { "type": "kernel", "keyColor": "#7dc4e4" },
    { "type": "lm", "keyColor": "#7dc4e4" },
    { "type": "de", "keyColor": "#7dc4e4" },
    { "type": "wm", "keyColor": "#7dc4e4" },
    { "type": "shell", "keyColor": "#7dc4e4" },
    { "type": "terminal", "keyColor": "#7dc4e4" },
    { "type": "font", "keyColor": "#7dc4e4" },
    { "type": "theme", "keyColor": "#7dc4e4" },
    { "type": "icons", "keyColor": "#7dc4e4" },
    { "type": "packages", "keyColor": "#7dc4e4" },
    { "type": "uptime", "keyColor": "#7dc4e4" },
    { "type": "locale", "keyColor": "#7dc4e4" },
    {
      "type": "custom", // InformationEnd
      "format": "\u001b[38;2;139;213;202m└\u001b[0m{$1}\u001b[38;2;139;213;202m──────────────────────\u001b[0m{$1}\u001b[38;2;139;213;202m┘\u001b[0m",
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 21,
    },
  ],
}
