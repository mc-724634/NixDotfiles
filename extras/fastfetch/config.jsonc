{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/nixos-logo.png",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 1,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "type": "string",
      "width": 12
    },
    "color": {
      "keys": "magenta",
      "title": "cyan",
      "output": "white",
      "separator": "bright_black"
    },
    "percent": {
      "type": 9
    }
  },

  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "terminal",
    "break",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk"
  ]
}
