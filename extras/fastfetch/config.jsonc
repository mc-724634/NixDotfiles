{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2,
    },
  },
  "display": {
    "separator": " \uf061 ",
    "constants": [
      "─────────────────", // {$1}, used in Custom module
    ],
    "key": {
      "type": "icon",
      "paddingLeft": 2,
    },
  },
  "modules": [
    {
      "type": "custom", // HardwareStart
      "format": "┌{$1} Hardware Information {$1}┐",
    },
    "host",
    "cpu",
    "gpu",
    "disk",
    "memory",
    "display",
    {
      "type": "custom", // HardwareEnd
      "format": "└{$1}──────────────────────{$1}┘",
    },
    {
      "type": "custom", // Separator
      "format": "",
    },
    {
      "type": "custom", // SoftwareStart
      "format": "┌{$1} Software Information {$1}┐",
    },
    "os",
    "kernel",
    "lm",
    "de",
    "wm",
    "shell",
    "terminal",
    "font",
    "theme",
    "icons",
    "packages",
    "uptime",
    "locale",
    {
      "type": "custom", // SoftwareEnd
      "format": "└{$1}──────────────────────{$1}┘",
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 21,
    },
  ],
}
