{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // NixOS logo (installed by modules/fastfetch.nix). "auto" draws it as an image
  // in Ghostty and falls back to the built-in logo if the file is missing.
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/nixos-logo.png",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 4,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "type": "string",
      "width": 12
    },
    "color": {
      "keys": "magenta",
      "title": "cyan",
      "output": "white",
      "separator": "bright_black"
    },
    "percent": {
      "type": 9
    }
  },

  "modules": [
    "title",
    "separator",

    // System
    "os",
    {
      // Distro age: fastfetch has no age module, but the root filesystem's
      // creation date is the day this install was made.
      "type": "disk",
      "folders": "/",
      "key": "Age",
      "format": "{days} days"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "break",

    // Desktop
    "de",
    "wm",
    {
      "type": "display",
      "key": "Display",
      "format": "{1}x{2} (@{3})"
    },
    "theme",
    "icons",
    "font",
    "break",

    // Hardware
    "cpu",
    "gpu",
    "memory",
    "swap",
    {
      "type": "disk",
      "folders": "/",
      "key": "Disk"
    }
  ]
}
