{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // Built-in ASCII logo instead of an image - no image-rendering support
  // needed in any terminal, and it picks up the terminal's own ANSI colors
  // instead of carrying fixed pixel colors of its own. Full-size logo (20
  // lines) is 3 lines shorter than the module block below (23 lines) -
  // fastfetch has no auto-centering, so padding.top is just half that gap,
  // confirmed by direct line counts rather than eyeballing it.
  "logo": {
    "type": "builtin",
    "source": "NixOS",
    "padding": {
      "top": 2,
      "right": 3
    }
  },

  "display": {
    "separator": " ",
    "key": {
      "type": "string",
      "width": 11
    },
    "color": {
      "keys": "cyan",
      "title": "magenta",
      "output": "white",
      "separator": "bright_black"
    },
    "percent": {
      "type": 9
    }
  },

  "modules": [
    "title",
    {
      "type": "custom",
      "format": "{#magenta}╭─────────────────────────╮{#}"
    },

    "os",
    {
      // Distro age: fastfetch has no age module, but the root filesystem's
      // creation date is the day this install was made.
      "type": "disk",
      "folders": "/",
      "key": "Age",
      "format": "{days} days"
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",

    {
      "type": "custom",
      "format": "{#bright_black}├─────────────────────────┤{#}"
    },

    "wm",
    {
      "type": "display",
      "key": "Display",
      "format": "{1}x{2} @{3}hz"
    },
    "theme",
    "icons",
    "font",

    {
      "type": "custom",
      "format": "{#bright_black}├─────────────────────────┤{#}"
    },

    "cpu",
    "gpu",
    "memory",
    "swap",
    {
      "type": "disk",
      "folders": "/",
      "key": "Disk"
    },

    {
      "type": "custom",
      "format": "{#magenta}╰─────────────────────────╯{#}"
    }
  ]
}
